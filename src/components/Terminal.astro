---
/*
  Terminal window that frames the main content. Tinted/translucent body so the
  WebGL grid background shows faintly through (see .terminal in global.css).
  Themed for dark and light. Accepts an optional window title.
*/
interface Props {
  title?: string;
}
const { title = 'madhav@portfolio: ~' } = Astro.props;
---

<div class="terminal">
  <div class="terminal-bar">
    <span class="terminal-dots" aria-hidden="true">
      <span class="dot dot-r"></span>
      <span class="dot dot-y"></span>
      <span class="dot dot-g"></span>
    </span>
    <span class="terminal-title">{title}</span>
  </div>
  <div class="terminal-body">
    <slot />
  </div>
</div>

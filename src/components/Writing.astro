---
import { getCollection } from 'astro:content';
import Section from './Section.astro';

// Hide drafts in production; show everything during local dev.
const posts = (
  await getCollection('writing', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true
  )
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

interface Props {
  index: string;
}
const { index } = Astro.props;
---

<Section id="writing" title="Writing" index={index}>
  {
    posts.length === 0 ? (
      <p class="text-sm text-fg-dim">Nothing published yet.</p>
    ) : (
      <ul class="flex flex-col">
        {posts.map((post) => {
          // A post links to its own generated page, unless `link` points it
          // off-site (e.g. a post hosted elsewhere).
          const href = post.data.link ?? `/writing/${post.id}`;
          const external = Boolean(post.data.link);
          return (
            <li class="group relative border-b border-border py-5 first:pt-0 last:border-b-0 last:pb-0">
              <div class="flex flex-col gap-x-6 gap-y-1 sm:flex-row sm:items-baseline">
                <time
                  datetime={post.data.date.toISOString()}
                  class="shrink-0 font-mono text-[0.7rem] tracking-wide text-fg-dim sm:w-28"
                >
                  {fmt(post.data.date)}
                </time>

                <div class="min-w-0">
                  <h3 class="text-[0.95rem] font-medium leading-snug text-fg">
                    <a
                      href={href}
                      target={external ? '_blank' : undefined}
                      rel={external ? 'noopener noreferrer' : undefined}
                      class="transition-colors after:absolute after:inset-0 after:content-[''] group-hover:text-accent"
                    >
                      {post.data.title}
                      {external && <span aria-hidden="true"> &#8599;</span>}
                    </a>
                  </h3>
                  <p class="mt-1 text-sm text-fg-dim">{post.data.blurb}</p>
                </div>
              </div>
            </li>
          );
        })}
      </ul>
    )
  }
</Section>

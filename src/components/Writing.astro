---
import { getCollection } from 'astro:content';

// Hide drafts in production; show everything during local dev.
const posts = (
  await getCollection('writing', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true
  )
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) => d.toISOString().slice(0, 10).replace(/-/g, '.');
---

<section id="writing" class="reveal border-t border-border/60 py-9" data-reveal>
  <h2 class="mb-8 font-mono text-sm text-accent">
    <span class="text-fg-dim">~/</span>writing
  </h2>

  {
    posts.length === 0 ? (
      <p class="font-mono text-sm text-fg-dim">
        // TODO: no posts yet — add Markdown files in src/content/writing/
      </p>
    ) : (
      <ul class="flex flex-col gap-7">
        {posts.map((post) => (
          <li class="border-l-2 border-border pl-5 transition-colors hover:border-accent">
            <p class="mb-1 font-mono text-xs text-fg-dim">
              <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
            </p>
            <h3 class="mb-1 font-mono text-sm font-semibold text-fg">
              {post.data.link ? (
                <a
                  href={post.data.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="transition-colors hover:text-accent"
                >
                  {post.data.title}
                </a>
              ) : (
                post.data.title
              )}
            </h3>
            <p class="text-sm leading-relaxed text-fg-dim">{post.data.blurb}</p>
          </li>
        ))}
      </ul>
    )
  }
</section>

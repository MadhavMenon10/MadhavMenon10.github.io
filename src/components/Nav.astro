---
import { site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

// On non-home pages (writing/project posts), nav anchors need an absolute
// path so they navigate back to the home page's sections rather than looking
// for a non-existent element on the current page.
const isHome = Astro.url.pathname === '/';
const navHref = (href: string) => isHome ? href : '/' + href;
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-border bg-bg/80 backdrop-blur-md"
>
  <nav
    aria-label="Primary"
    class="mx-auto flex h-[var(--nav-h)] max-w-3xl items-center justify-between px-4 sm:px-6"
  >
    <a
      href="#top"
      id="nav-name"
      aria-label={site.name}
      class="hidden font-mono text-sm font-semibold tracking-tight text-fg transition-colors hover:text-accent sm:block"
    >
      <span id="nav-name-glyph" aria-hidden="true" class="mr-1.5 inline-block"></span>{site.name}
    </a>

    <div class="flex items-center gap-1 sm:gap-3">
      <ul class="flex items-center gap-0.5 font-mono text-[0.7rem] sm:gap-1 sm:text-xs">
        {
          site.nav.map((item) => (
            <li>
              <a
                href={navHref(item.href)}
                class="rounded px-2 py-1 text-fg-dim transition-colors hover:text-accent"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ThemeToggle />
    </div>
  </nav>
</header>

<script>
  // Hover the name to cycle a glyph — shown beside the name, not over it — through
  // the author's initial across the scripts/languages he speaks: Malayalam, Tamil,
  // Devanagari (Hindi), English, Spanish, Greek. The name stays put; the glyph
  // clears on leave. Skipped for reduced-motion users.
  const link = document.getElementById('nav-name');
  const glyph = document.getElementById('nav-name-glyph');
  if (link && glyph) {
    const glyphs = ['ക', 'க', 'क', 'M', 'Ñ', 'μ']; // ക க क M Ñ μ (Greek mu)
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timer: number | null = null;
    let i = 0;

    const start = () => {
      if (reduce || timer !== null) return;
      glyph.textContent = glyphs[i % glyphs.length];
      timer = window.setInterval(() => {
        i += 1;
        glyph.textContent = glyphs[i % glyphs.length];
      }, 250);
    };
    const stop = () => {
      if (timer !== null) {
        clearInterval(timer);
        timer = null;
      }
      i = 0;
      glyph.textContent = '';
    };

    link.addEventListener('mouseenter', start);
    link.addEventListener('mouseleave', stop);
    link.addEventListener('focus', start);
    link.addEventListener('blur', stop);
  }
</script>

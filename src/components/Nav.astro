---
import { site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

// On post pages the anchors need an absolute path so they navigate back to the
// home page's sections rather than looking for a missing element here.
const isHome = Astro.url.pathname === '/';
const navHref = (href: string) => (isHome ? href : '/' + href);
---

<!--
  No name in the bar: the hero already carries it as the page heading, and
  repeating it here just doubled it up. Links sit at the left edge and the
  toggle at the right, both aligned with the content column below.
-->
<header class="sticky top-0 z-50 border-b border-border bg-bg/85 backdrop-blur-sm">
  <nav
    aria-label="Primary"
    class="mx-auto flex h-[var(--nav-h)] max-w-2xl items-center justify-between gap-3 px-5 sm:px-6"
  >
    <ul class="nav-scroll flex min-w-0 items-center overflow-x-auto">
      {
        site.nav.map((item) => (
          <li>
            <a
              href={navHref(item.href)}
              class="block whitespace-nowrap px-1.5 py-1 font-mono text-[0.7rem] text-fg-dim transition-colors hover:text-fg sm:px-2"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <ThemeToggle />
  </nav>
</header>

---
import { site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

// On post pages the anchors need an absolute path so they navigate back to the
// home page's sections rather than looking for a missing element here.
const isHome = Astro.url.pathname === '/';
const navHref = (href: string) => (isHome ? href : '/' + href);
---

<header class="sticky top-0 z-50 border-b border-border bg-bg/85 backdrop-blur-sm">
  <nav
    aria-label="Primary"
    class="mx-auto flex h-[var(--nav-h)] max-w-2xl items-center justify-between gap-4 px-5 sm:px-6"
  >
    <!-- The name is the site's anchor on desktop; on phones the nav row needs
         the width, so only the section links and the toggle survive. -->
    <a
      href={isHome ? '#top' : '/'}
      id="nav-name"
      class="hidden shrink-0 font-mono text-[0.8rem] font-medium tracking-tight text-fg transition-colors hover:text-accent sm:block"
    >
      <span id="nav-name-glyph" aria-hidden="true" class="inline-block w-[1.1ch]"></span>
      Madhav Anand Menon
    </a>

    <div class="flex flex-1 items-center justify-between gap-1 sm:flex-none sm:justify-end">
      <ul class="flex items-center">
        {
          site.nav.map((item) => (
            <li>
              <a
                href={navHref(item.href)}
                class="px-1.5 py-1 font-mono text-[0.7rem] text-fg-dim transition-colors hover:text-fg sm:px-2"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ThemeToggle />
    </div>
  </nav>
</header>

<script>
  // Hovering the name cycles a single glyph beside it — the author's initial
  // across the scripts he reads: Malayalam, Tamil, Devanagari, Latin, Spanish,
  // Greek. The name itself never moves. Skipped for reduced-motion users.
  const link = document.getElementById('nav-name');
  const glyph = document.getElementById('nav-name-glyph');

  if (link && glyph) {
    const glyphs = ['ക', 'க', 'क', 'M', 'Ñ', 'μ'];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timer: number | null = null;
    let i = 0;

    const start = () => {
      if (reduce || timer !== null) return;
      glyph.textContent = glyphs[i % glyphs.length];
      timer = window.setInterval(() => {
        i += 1;
        glyph.textContent = glyphs[i % glyphs.length];
      }, 220);
    };

    const stop = () => {
      if (timer !== null) {
        clearInterval(timer);
        timer = null;
      }
      i = 0;
      glyph.textContent = '';
    };

    link.addEventListener('mouseenter', start);
    link.addEventListener('mouseleave', stop);
    link.addEventListener('focus', start);
    link.addEventListener('blur', stop);
  }
</script>

---
import { site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-border bg-bg/80 backdrop-blur-md"
>
  <nav
    aria-label="Primary"
    class="mx-auto flex h-[var(--nav-h)] max-w-3xl items-center justify-between px-4 sm:px-6"
  >
    <a
      href="#top"
      class="hidden font-mono text-sm font-semibold tracking-tight text-fg transition-colors hover:text-accent sm:block"
    >
      {site.name.toLowerCase()}
    </a>

    <div class="flex items-center gap-1 sm:gap-3">
      <ul class="flex items-center gap-0.5 font-mono text-[0.7rem] sm:gap-1 sm:text-xs">
        {
          site.nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="rounded px-2 py-1 text-fg-dim transition-colors hover:text-accent"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ThemeToggle />
    </div>
  </nav>
</header>

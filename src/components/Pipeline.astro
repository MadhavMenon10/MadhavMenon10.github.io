---
/*
  Schematic GPU pipeline: MEMORY -> WARPS -> OUTPUT, with data packets flowing
  through. Animation is CSS-only (see global.css), triggered when reveal.ts adds
  `.in-view`. Fully static and visible with no JS / prefers-reduced-motion.
*/
---

<figure
  class="pipeline mb-12"
  data-reveal
  aria-label="Schematic GPU pipeline: data flows from memory, through compute warps, to output."
>
  <svg viewBox="0 0 640 170" class="h-auto w-full" role="img">
    <defs>
      <marker
        id="pipe-arrow"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="6"
        markerHeight="6"
        orient="auto-start-reverse"
      >
        <path d="M0,0 L10,5 L0,10 z" fill="currentColor" />
      </marker>
    </defs>

    <!-- connectors -->
    <g class="pipe-wires" stroke="currentColor" stroke-width="1.5" opacity="0.55">
      <line x1="172" y1="85" x2="240" y2="85" marker-end="url(#pipe-arrow)" />
      <line x1="402" y1="85" x2="470" y2="85" marker-end="url(#pipe-arrow)" />
    </g>

    <!-- stages -->
    <g class="stages">
      <g class="stage">
        <rect x="22" y="50" width="150" height="70" rx="8" />
        <text x="97" y="83" class="stage-title">MEMORY</text>
        <text x="97" y="101" class="stage-sub">DRAM · VRAM</text>
      </g>
      <g class="stage">
        <rect x="245" y="50" width="150" height="70" rx="8" />
        <text x="320" y="83" class="stage-title">WARPS</text>
        <text x="320" y="101" class="stage-sub">SIMT cores</text>
      </g>
      <g class="stage">
        <rect x="468" y="50" width="150" height="70" rx="8" />
        <text x="543" y="83" class="stage-title">OUTPUT</text>
        <text x="543" y="101" class="stage-sub">framebuffer</text>
      </g>
    </g>

    <!-- flowing data packets (CSS-animated) -->
    <g class="packets" aria-hidden="true">
      <rect class="packet" x="26" y="72" width="11" height="6" rx="1.5" />
      <rect class="packet" x="26" y="82" width="11" height="6" rx="1.5" />
      <rect class="packet" x="26" y="92" width="11" height="6" rx="1.5" />
      <rect class="packet" x="26" y="77" width="11" height="6" rx="1.5" />
      <rect class="packet" x="26" y="87" width="11" height="6" rx="1.5" />
    </g>
  </svg>

  <figcaption class="mt-3 text-center font-mono text-xs text-fg-dim">
    memory → warps → output
  </figcaption>
</figure>

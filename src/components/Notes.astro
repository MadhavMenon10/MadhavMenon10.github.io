---
import Section from './Section.astro';
import AsciiWell from './AsciiWell.astro';
import { notes } from '../data/site';

// Latest semester first (Spring sorts before Fall within a year), then by
// course code alphabetically — e.g. MATH before PHYS in the same semester.
// A year given as a range sorts by the year it finished.
const termRank = (t: string) => (t === 'Spring' ? 1 : 2);
const endYear = (y: number | string) =>
  typeof y === 'number' ? y : Math.max(...(y.match(/\d{4}/g) ?? ['0']).map(Number));
const sortKey = (n: (typeof notes)[number]) => endYear(n.year) * 10 + termRank(n.term);
const sorted = [...notes].sort(
  (a, b) => sortKey(b) - sortKey(a) || a.code.localeCompare(b.code)
);

interface Props {
  index: string;
}
const { index } = Astro.props;
---

<Section id="notes" title="Notes" index={index}>
  <AsciiWell />

  <p class="text-sm text-fg-dim">
    Some of my notes from courses I've taken at UIUC. Some were written by hand and
    transcribed to LaTeX with AI, and some sections may be incomplete where they
    weren't covered in class. These will (hopefully) be updated at some point.
  </p>

  <ul class="mt-6 flex flex-col">
    {
      sorted.map((n) => (
        <li class="group relative flex items-baseline gap-x-4 border-b border-border py-3.5 first:pt-0 last:border-b-0 last:pb-0">
          <span class="shrink-0 font-mono text-[0.7rem] tracking-wide text-fg-dim sm:w-28">
            {n.code}
          </span>

          <span class="min-w-0 flex-1 text-sm">
            {n.pdf ? (
              <a
                href={n.pdf}
                target="_blank"
                rel="noopener noreferrer"
                class="text-fg transition-colors after:absolute after:inset-0 after:content-[''] group-hover:text-accent"
                aria-label={`Open ${n.code} ${n.title} notes in a new tab`}
              >
                {n.title}
                <span aria-hidden="true"> &#8599;</span>
              </a>
            ) : (
              <span class="text-fg-dim">{n.title} · coming soon</span>
            )}
          </span>

          <span class="shrink-0 font-mono text-[0.7rem] text-fg-dim">
            {`${n.term} ${n.year}`}
          </span>
        </li>
      ))
    }
  </ul>
</Section>

---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import GpuDiagram from './GpuDiagram.astro';

const projects = (
  await getCollection('projects', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true
  )
).sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));
---

<section id="projects" class="reveal border-t border-border/60 py-9" data-reveal>
  <h2 class="mb-8 font-mono text-sm text-accent">
    <span class="text-fg-dim">~/</span>Projects
  </h2>

  <p class="font-mono text-sm text-fg-dim">// To be completed</p>
</section>

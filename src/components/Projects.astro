---
import { site } from '../data/site';
import ProjectCard from './ProjectCard.astro';
import GpuDiagram from './GpuDiagram.astro';
---

<section id="projects" class="reveal border-t border-border/60 py-9" data-reveal>
  <h2 class="mb-8 font-mono text-sm text-accent">
    <span class="text-fg-dim">~/</span>projects
  </h2>

  <GpuDiagram />

  <!-- Active filter chip (populated by gpu-map.ts when a core type is clicked) -->
  <div id="project-filter" class="gpu-filterbar" hidden></div>

  <div id="project-grid" class="grid gap-4 sm:grid-cols-2">
    {site.projects.map((project) => <ProjectCard project={project} />)}
  </div>
</section>

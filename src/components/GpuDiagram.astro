---
/*
  Portfolio "Streaming Multiprocessor" — a GPU SM whose functional units map
  directly to sections of this site.

  Architecture as site metaphor:
    ~/about           (L1 cache)   → about section
    Four processing blocks, each labeled for a project domain:
      Block 0  "// systems"        — INT32-analog cores filter systems projects
      Block 1  "// ml & data"      — FP32-analog cores filter ML projects
      Block 2  "// science"        — FP64-analog cores filter science projects
      Block 3  "// ai · dl"        — Tensor cores filter AI/DL projects
    ~/links           (LD/ST)      → links section
    ~/write           (SFU)        → writing section
    contact           (TMA)        → mailto

  Cores labelled SYS / ML / SCI (the main interactive filter units) with
  the domain-specific L0 bar clarifying what each block "specializes" in.
  See gpu-map.ts for interaction behavior; site.ts for unit → destination.
*/
import { gpu } from '../data/site';
import GpuUnit from './GpuUnit.astro';

const blocks = [0, 1, 2, 3];
const lanes  = Array.from({ length: 16 });
const ldst   = Array.from({ length: 8 });

const blockMeta = [
  { l0: '// systems',   warp: 'scheduler · nav', dispatch: 'gpu-map.ts', reg: 'content/*.md' },
  { l0: '// ml & data', warp: 'scheduler · nav', dispatch: 'gpu-map.ts', reg: 'content/*.md' },
  { l0: '// science',   warp: 'scheduler · nav', dispatch: 'gpu-map.ts', reg: 'content/*.md' },
  { l0: '// ai · dl',   warp: 'scheduler · nav', dispatch: 'gpu-map.ts', reg: 'content/*.md' },
];

const meta   = Object.fromEntries(gpu.units.map((u) => [u.id, u]));
const hrefFor = (id: string) => {
  const u = meta[id];
  if (u.kind === 'filter') return '#projects';
  if (u.kind === 'mailto') return `mailto:${u.target}`;
  return u.target;
};
---

<figure
  class="gpu"
  data-reveal
  aria-label="Interactive portfolio site map rendered as a GPU streaming multiprocessor. ~/about at the top links to the about section; four processing blocks — systems, ml & data, science, ai · dl — contain core units that filter projects by domain; LD/ST links to the links section; SFU links to writing; contact at the bottom opens email."
>
  <p class="gpu-hint">
    <b>// interactive</b> — hover or click a compute unit · cores filter projects · others navigate
  </p>

  <div class="gpu-scroll">
    <div class="gpu-sm">

      <GpuUnit unit="l1" rep meta={meta.l1} href={hrefFor('l1')} cls="gpu-cache gpu-l1">
        ~/about
      </GpuUnit>

      <div class="gpu-quad">
        {
          blocks.map((b) => (
            <div class="gpu-block">
              <div class="gpu-bar gpu-l0">{blockMeta[b].l0}</div>
              <div class="gpu-bar gpu-warp">{blockMeta[b].warp}</div>
              <div class="gpu-bar gpu-dispatch">{blockMeta[b].dispatch}</div>
              <div class="gpu-bar gpu-reg">{blockMeta[b].reg}</div>

              <div class="gpu-cores">
                <GpuUnit unit="int" rep={b === 0} meta={meta.int} href={hrefFor('int')} cls="gpu-col gpu-int">
                  {lanes.map(() => <span>SYS</span>)}
                </GpuUnit>
                <GpuUnit unit="fp32" rep={b === 0} meta={meta.fp32} href={hrefFor('fp32')} cls="gpu-col gpu-fp32">
                  {lanes.map(() => <span>ML</span>)}
                </GpuUnit>
                <GpuUnit unit="fp32" rep={false} meta={meta.fp32} href={hrefFor('fp32')} cls="gpu-col gpu-fp32">
                  {lanes.map(() => <span>ML</span>)}
                </GpuUnit>
                <GpuUnit unit="fp64" rep={b === 0} meta={meta.fp64} href={hrefFor('fp64')} cls="gpu-col gpu-fp64">
                  {lanes.map(() => <span>SCI</span>)}
                </GpuUnit>
                <GpuUnit unit="tensor" rep={b === 0} meta={meta.tensor} href={hrefFor('tensor')} cls="gpu-tensor">
                  <span class="gpu-tensor-t">AI / DL</span>
                  <span class="gpu-tensor-s">tensor core</span>
                </GpuUnit>
              </div>

              <div class="gpu-units">
                <GpuUnit unit="ldst" rep={b === 0} meta={meta.ldst} href={hrefFor('ldst')} cls="gpu-ldst-group">
                  {ldst.map(() => <span class="gpu-ldst">link</span>)}
                </GpuUnit>
                <GpuUnit unit="sfu" rep={b === 0} meta={meta.sfu} href={hrefFor('sfu')} cls="gpu-sfu">
                  write
                </GpuUnit>
              </div>
            </div>
          ))
        }
      </div>

      <GpuUnit unit="tma" rep meta={meta.tma} href={hrefFor('tma')} cls="gpu-cache gpu-tma">
        contact
      </GpuUnit>

    </div>
  </div>

  <div class="gpu-readout" aria-hidden="true">
    <span class="gpu-prompt">madhav@portfolio:~$</span>
    <span class="gpu-cmd">// hover a unit · click to navigate</span><span class="gpu-caret">&#9612;</span>
  </div>

  <figcaption class="gpu-cap">
    portfolio SM · a clickable map of the site
  </figcaption>
</figure>

<script>
  import { initGpuMap } from '../scripts/gpu-map';
  initGpuMap();
</script>

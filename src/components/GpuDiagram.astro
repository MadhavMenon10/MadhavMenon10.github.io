---
/*
  Streaming Multiprocessor (SM) block diagram — a stylized take on a modern
  NVIDIA SM (Hopper-class: 4th-gen Tensor Cores + Tensor Memory Accelerator):

    L1 Instruction Cache
    └ 4 processing blocks, each:
        L0 I-cache · Warp Scheduler · Dispatch · Register File
        INT32 | FP32 | FP32 | FP64 cores + 4th-gen Tensor Core
        LD/ST ×8 + SFU
    Tensor Memory Accelerator

  Pure HTML/CSS (styles in global.css). Staggered reveal via reveal.ts adding
  `.in-view`; static & visible with no JS / prefers-reduced-motion.
*/
const blocks = [0, 1, 2, 3];
const lanes = Array.from({ length: 16 });
const ldst = Array.from({ length: 8 });
---

<figure
  class="gpu"
  data-reveal
  aria-label="Stylized NVIDIA streaming-multiprocessor block diagram: an L1 instruction cache feeds four processing blocks — each with a warp scheduler, dispatch unit, register file, INT32/FP32/FP64 cores and a 4th-generation tensor core, plus load/store units and a special-function unit — above a tensor memory accelerator."
>
  <div class="gpu-scroll">
    <div class="gpu-sm">
      <div class="gpu-cache gpu-l1">L1 Instruction Cache</div>

      <div class="gpu-quad">
        {
          blocks.map(() => (
            <div class="gpu-block">
              <div class="gpu-bar gpu-l0">L0 Instruction Cache</div>
              <div class="gpu-bar gpu-warp">Warp Scheduler (32 thread/clk)</div>
              <div class="gpu-bar gpu-dispatch">Dispatch Unit (32 thread/clk)</div>
              <div class="gpu-bar gpu-reg">Register File (16,384 &times; 32-bit)</div>

              <div class="gpu-cores">
                <div class="gpu-col gpu-int">{lanes.map(() => <span>INT32</span>)}</div>
                <div class="gpu-col gpu-fp32">{lanes.map(() => <span>FP32</span>)}</div>
                <div class="gpu-col gpu-fp32">{lanes.map(() => <span>FP32</span>)}</div>
                <div class="gpu-col gpu-fp64">{lanes.map(() => <span>FP64</span>)}</div>
                <div class="gpu-tensor">
                  <span class="gpu-tensor-t">TENSOR CORE</span>
                  <span class="gpu-tensor-s">4TH GEN</span>
                </div>
              </div>

              <div class="gpu-units">
                {ldst.map(() => <span class="gpu-ldst">LD/ST</span>)}
                <span class="gpu-sfu">SFU</span>
              </div>
            </div>
          ))
        }
      </div>

      <div class="gpu-cache gpu-tma">Tensor Memory Accelerator</div>
    </div>
  </div>

  <figcaption class="gpu-cap">
    streaming multiprocessor — instruction cache → warps → cores → output
  </figcaption>
</figure>

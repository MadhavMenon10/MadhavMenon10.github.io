---
import { site } from '../data/site';
---

<section
  id="top"
  class="relative flex min-h-[100svh] items-center"
>
  <div class="mx-auto flex w-full max-w-3xl items-center justify-between gap-10 px-4 sm:px-6">
    <!-- Text block -->
    <div class="flex-1">
      <p class="mb-4 font-mono text-xs text-accent sm:text-sm">{site.role}</p>

      <h1
        class="font-mono text-4xl font-bold leading-[1.05] tracking-tight text-fg sm:text-6xl"
      >
        {site.name}
      </h1>

      <p class="mt-5 max-w-xl font-mono text-sm text-fg-dim sm:text-base">
        {site.tagline}
      </p>
    </div>

    <!-- Circular headshot -->
    <div class="hero-headshot-wrap">
      <img
        src="/headshot.png"
        alt={site.name}
        class="hero-headshot"
        width="180"
        height="180"
        loading="eager"
        decoding="async"
      />
    </div>
  </div>
</section>

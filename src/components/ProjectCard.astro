---
import type { Project } from '../data/site';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, description, tags, href, units } = project;
---

<article
  class="group relative rounded-lg border border-border bg-bg-elev p-5 transition-colors hover:border-border-hover hover:bg-bg-elev-hover"
  data-units={units?.join(' ')}
>
  {
    href && (
      <a href={href} class="absolute inset-0 z-10 rounded-lg" aria-label={title} />
    )
  }

  <h3 class="mb-2 font-mono text-sm font-semibold leading-snug text-fg">
    {title}
  </h3>

  <p class="mb-4 text-sm leading-relaxed text-fg-dim">{description}</p>

  <ul class="flex flex-wrap gap-1.5">
    {
      tags.map((tag) => (
        <li class="rounded border border-border bg-bg px-2 py-0.5 font-mono text-[0.7rem] text-fg-dim">
          {tag}
        </li>
      ))
    }
  </ul>
</article>

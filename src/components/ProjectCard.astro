---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, description, tags, github, link, linkLabel, image, imageAlt, imageFit } =
  project.data;
---

<!--
  A row, not a card: hairline divider, thumbnail, title, blurb, meta. The title
  anchor stretches over the whole row via ::after so the row is clickable, and
  the GitHub / demo links sit above it on z-10 so they stay independently
  clickable.
-->
<li
  class="group relative border-b border-border py-6 first:pt-0 last:border-b-0 last:pb-0"
>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:gap-5">
    {
      image && (
        <img
          src={image}
          alt={imageAlt ?? title}
          class:list={[
            'aspect-[16/10] w-full shrink-0 rounded border border-border bg-bg-soft transition-colors group-hover:border-border-strong sm:w-44',
            imageFit === 'contain' ? 'object-contain' : 'object-cover',
          ]}
          loading="lazy"
          decoding="async"
        />
      )
    }

    <div class="min-w-0 flex-1">
      <h3 class="text-[0.95rem] font-medium leading-snug text-fg">
        <a
          href={`/projects/${project.id}`}
          class="transition-colors after:absolute after:inset-0 after:content-[''] group-hover:text-accent"
        >
          {title}
        </a>
      </h3>

      <p class="mt-1.5 text-sm text-fg-dim">{description}</p>

      <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1.5">
        {
          tags.length > 0 && (
            <p class="font-mono text-[0.7rem] tracking-wide text-fg-dim">
              {tags.join(' · ')}
            </p>
          )
        }
        {
          github && (
            <a
              href={github}
              target="_blank"
              rel="noopener noreferrer"
              class="relative z-10 font-mono text-[0.7rem] text-fg-dim transition-colors hover:text-accent"
            >
              GitHub &#8599;
            </a>
          )
        }
        {
          link && (
            <a
              href={link}
              target="_blank"
              rel="noopener noreferrer"
              class="relative z-10 font-mono text-[0.7rem] text-fg-dim transition-colors hover:text-accent"
            >
              {linkLabel} &#8599;
            </a>
          )
        }
      </div>
    </div>
  </div>
</li>

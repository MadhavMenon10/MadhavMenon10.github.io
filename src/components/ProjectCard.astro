---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, description, tags, github, link, units } = project.data;
---

<article
  class="flex flex-col rounded-lg border border-border bg-bg-elev p-5 transition-colors hover:border-border-hover"
  data-units={units?.join(' ')}
>
  <h3 class="mb-2 font-mono text-sm font-semibold leading-snug text-fg">{title}</h3>
  <p class="mb-4 text-sm leading-relaxed text-fg-dim">{description}</p>

  {
    tags.length > 0 && (
      <ul class="mb-4 flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <li class="rounded border border-border bg-bg px-2 py-0.5 font-mono text-[0.7rem] text-fg-dim">
            {tag}
          </li>
        ))}
      </ul>
    )
  }

  <div class="mt-auto flex items-center gap-4 pt-1">
    {
      github && (
        <a
          href={github}
          target="_blank"
          rel="noopener noreferrer"
          class="text-fg-dim transition-colors hover:text-accent"
          aria-label={`GitHub repository: ${title}`}
        >
          <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.65 7.65 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
          </svg>
        </a>
      )
    }
    {
      link && (
        <a
          href={link}
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-xs text-fg-dim transition-colors hover:text-accent"
        >
          demo &#8599;
        </a>
      )
    }
    <a
      href={`/projects/${project.id}`}
      class="ml-auto font-mono text-xs text-fg-dim transition-colors hover:text-accent"
    >
      read more &#8594;
    </a>
  </div>
</article>

---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="mx-auto w-full max-w-2xl px-5 pb-16 sm:px-6">
  <div
    class="flex items-center justify-between gap-4 border-t border-border pt-7 font-mono text-[0.7rem] text-fg-dim"
  >
    <span>&copy; {year} {site.name}</span>
    <span aria-hidden="true">|&psi;&rang;</span>
  </div>
</footer>

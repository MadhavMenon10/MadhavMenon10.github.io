---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Terminal from '../../components/Terminal.astro';
import { site } from '../../data/site';

// One page per Markdown file in src/content/projects/ — this is the "read more"
// view. Drafts are skipped in production, viewable in `npm run dev`.
export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true
  );
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, tags, github, link } = project.data;
---

<Base title={`${title} · ${site.name}`} description={description}>
  <div class="relative z-10 mx-auto w-full max-w-3xl px-4 pb-24 pt-28 sm:px-6">
    <Terminal title={`madhav@portfolio: ~/projects/${project.id}`}>
      <article class="post-body">
        <p class="post-back"><a href="/#projects">&#8592; back to projects</a></p>
        <h1 class="post-title">{title}</h1>
        <p class="mb-4 text-base leading-relaxed text-fg-dim">{description}</p>

        {
          tags.length > 0 && (
            <ul class="mb-4 flex flex-wrap gap-1.5">
              {tags.map((tag) => (
                <li class="rounded border border-border bg-bg-elev px-2 py-0.5 font-mono text-[0.7rem] text-fg-dim">
                  {tag}
                </li>
              ))}
            </ul>
          )
        }

        {
          (github || link) && (
            <div class="mb-8 flex items-center gap-4">
              {github && (
                <a
                  href={github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 font-mono text-xs text-fg-dim transition-colors hover:text-accent"
                >
                  <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
                    <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.65 7.65 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
                  </svg>
                  github
                </a>
              )}
              {link && (
                <a
                  href={link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-mono text-xs text-fg-dim transition-colors hover:text-accent"
                >
                  demo &#8599;
                </a>
              )}
            </div>
          )
        }

        <Content />
      </article>
    </Terminal>
  </div>
</Base>

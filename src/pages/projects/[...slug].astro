---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';

// One page per Markdown file in src/content/projects/ — this is the "read more"
// view. Drafts are skipped in production, viewable in `npm run dev`.
export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true
  );
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, tags, github, link, linkLabel } = project.data;
---

<Base title={`${title} · ${site.name}`} description={description}>
  <article>
    <a
      href="/#projects"
      class="font-mono text-[0.7rem] text-fg-dim transition-colors hover:text-fg"
    >
      &#8592; Projects
    </a>

    <h1 class="mt-10 text-2xl font-semibold tracking-[-0.02em] text-fg">{title}</h1>
    <p class="mt-3 text-fg-dim">{description}</p>

    <div
      class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1.5 border-b border-border pb-8"
    >
      {
        tags.length > 0 && (
          <p class="font-mono text-[0.7rem] tracking-wide text-fg-dim">
            {tags.join(' · ')}
          </p>
        )
      }
      {
        github && (
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-[0.7rem] text-fg-dim transition-colors hover:text-accent"
          >
            GitHub &#8599;
          </a>
        )
      }
      {
        link && (
          <a
            href={link}
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-[0.7rem] text-fg-dim transition-colors hover:text-accent"
          >
            {linkLabel} &#8599;
          </a>
        )
      }
    </div>

    <div class="prose mt-9">
      <Content />
    </div>
  </article>
</Base>

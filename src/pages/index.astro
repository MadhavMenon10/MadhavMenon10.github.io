---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Awards from '../components/Awards.astro';
import Projects from '../components/Projects.astro';
import Writing from '../components/Writing.astro';
import Notes from '../components/Notes.astro';
import { experience, awards } from '../data/site';

// Section numbering lives here so it stays contiguous. Experience and Awards
// drop out entirely while their lists are empty, and the sections after them
// renumber themselves rather than leaving a hole in the sequence.
const order = [
  'about',
  ...(experience.length ? ['experience'] : []),
  ...(awards.length ? ['awards'] : []),
  'projects',
  'writing',
  'notes',
];
const num = Object.fromEntries(
  order.map((id, i) => [id, String(i + 1).padStart(2, '0')])
);
---

<Base>
  <Hero />
  <About index={num.about} />
  {experience.length > 0 && <Experience index={num.experience} />}
  {awards.length > 0 && <Awards index={num.awards} />}
  <Projects index={num.projects} />
  <Writing index={num.writing} />
  <Notes index={num.notes} />
</Base>

---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Terminal from '../components/Terminal.astro';
import About from '../components/About.astro';
import Links from '../components/Links.astro';
import Projects from '../components/Projects.astro';
import Writing from '../components/Writing.astro';
---

<Base>
  <Hero />

  <!-- terminal-wrapper is a placeholder; terminal.ts moves #main-terminal
       to <body> and makes it a fixed overlay, collapsing this wrapper. -->
  <div id="terminal-wrapper">
    <Terminal title="madhav@website: ~">
      <About />
      <Links />
      <Projects />
      <Writing />
    </Terminal>
  </div>

  <!-- Fixed scroll indicator shown by terminal.ts when the terminal is open -->
  <div id="scroll-prompt" class="scroll-prompt" aria-hidden="true" hidden>
    <span>↓</span>
    <span class="scroll-prompt-label">scroll</span>
  </div>
</Base>
